#!/bin/bash
# The macOS download for an XN app ("Install <App>.app"): runs the app's own installer (the same command as its
# README), writes what it says to a log, and shows the log as it grows in a window of its own (window.js, drawn with
# Cocoa through the scripting built into macOS). When it finishes the window says so in a popup.
# @APP@ and @COMMAND@ are filled in by ../build.sh.
APP='@APP@'
COMMAND='@COMMAND@'
here="$(cd "$(dirname "$0")/../Resources" && pwd)"
dir="$(mktemp -d -t xn-install)"
log="$dir/install.log"; status="$dir/status"
printf 'Installing %s. Running its installer:\n  %s\n\n' "$APP" "$COMMAND" > "$log"
# an app opened from Finder has a bare PATH: add where Homebrew and the installers' own tools live
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
(
  /bin/bash -lc "$COMMAND" < /dev/null 2>&1 | /usr/bin/perl -pe '$|=1; s/\e\[[0-9;?]*[ -\/]*[@-~]//g; s/^.*\r(?=.)//' >> "$log"
  echo "${PIPESTATUS[0]}" > "$status"
) &
/usr/bin/osascript -l JavaScript "$here/window.js" "$APP" "$log" "$status"
wait
